  "components": {
    "aceEditor": "
 .ace_editor {
    border: 1px solid #b7b7b7bd !important;
    border-radius: 0;
  }

  .ace-graylog {
    background-color: #0b42ff;
    color: #f0f0f0;

    &.ace_multiselect .ace_selection.ace_start {
      box-shadow: 0 0 3px 0 #0b42ff;
    }

    .ace_gutter {
      background: #5f5f5f;
      color: #f0f0f0;
    }

    .ace_print-margin {
      width: 1px;
      background: #4b4b4b;
    }

    .ace_cursor {
      border-color: #5c6370;
    }

    .ace_marker-layer {
      .ace_selection {
        background: Highlight;
      }

      .ace_step {
        background: rgb(255 255 0);
      }

      .ace_bracket {
        margin: -1px 0 0 -1px;
        border: 1px solid #b0b0b0;
      }

      .ace_selected-word {
        border: 1px solid #bdbdbd;
        background: transparent;
      }

      .ace_active-line {
        background: #4b4b4b;
      }
    }

    .ace_gutter-active-line {
      background-color: #4b4b4b;
    }

    .ace_invisible {
      color: #b0b0b0;
    }

    .ace_keyword,
    .ace_meta,
    .ace_storage,
    .ace_storage.ace_type,
    .ace_support.ace_type {
      color: #8cb5ea;
    }

    .ace_keyword.ace_operator {
      color: #bfbfff;
    }

    .ace_constant.ace_character,
    .ace_constant.ace_language,
    .ace_constant.ace_numeric,
    .ace_keyword.ace_other.ace_unit,
    .ace_support.ace_constant,
    .ace_variable.ace_parameter {
      color: #d1bfd1;
    }

    .ace_constant.ace_other {
      color: #d1d1d1;
    }

    .ace_invalid {
      color: #ffebeb;
      background-color: #f20000;
    }

    .ace_invalid.ace_deprecated {
      color: #ffebeb;
      background-color: #800080;
    }

    .ace_fold {
      background-color: #0000FF;
      border-color: #f0f0f0;
    }

    .ace_entity.ace_name.ace_function,
    .ace_support.ace_function,
    .ace_variable {
      color: #0000FF;
    }

    .ace_support.ace_class,
    .ace_support.ace_type {
      color: #ffffbf;
    }

    .ace_heading,
    .ace_markup.ace_heading,
    .ace_string {
      color: #bfd1bf;
    }

    .ace_entity.ace_name.ace_tag,
    .ace_entity.ace_other.ace_attribute-name,
    .ace_meta.ace_tag,
    .ace_string.ace_regexp,
    .ace_variable {
      color: #f20000;
    }

    .ace_comment {
      color: #5c637099;
    }

    .ace_tooltip {
      background-color: #89a4ff;
      padding: 4px;
      padding-left: 0;
      line-height: 1.5;
      
      .ace_icon {
        margin-right: 3px;
      }
    }
  }
",
