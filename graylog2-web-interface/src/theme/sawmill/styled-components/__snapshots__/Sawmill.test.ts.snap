    "xs": "0.40rem",
    "xxl": "4.40rem",
    "xxs": "0.24rem",
  },
  "utils": {
    "colorLevel": [Function],
    "contrastingColor": [Function],
    "flattenColorStack": [Function],
    "mixColor": [Function],
    "opacify": [Function],
