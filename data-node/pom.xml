        <mainClass>org.graylog.datanode.bootstrap.Main</mainClass>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 2.x versions -->
        <opensearch.compat.version>2.19.6</opensearch.compat.version>
        <lucene.compat.version>9.12.3-1</lucene.compat.version>
        <!-- 3.x versions -->
        <opensearch.latest.version>3.5.0</opensearch.latest.version>
        <opensearch.cache.url>
            https://graylog-ci-cache.s3.eu-west-1.amazonaws.com/downloads/datanode-opensearch
        </opensearch.cache.url>
        <opensearch.distribution.platform>linux</opensearch.distribution.platform>

        <!--
           We don't need to sign anything in this module. This fixes a release build error related to setting
           the <outputDirectory> to a different path: https://issues.apache.org/jira/browse/MGPG-44
        -->
        <gpg.skip>true</gpg.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
    </properties>

